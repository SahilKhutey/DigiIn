# ==============================================================================
# DigiIn (DigiLocker X) — Production Environment Variable Specifications
# ==============================================================================
# NEVER commit production secrets or actual connection credentials to Git.

# --- Frontend (Vercel) ---
VITE_API_BASE_URL=

# --- Backend (Render) ---
ENVIRONMENT=production
ALLOWED_ORIGINS=

# --- Database (Supabase PostgreSQL) ---
DIGIIN_DATABASE_URL=

# --- Demo & Sandbox Safety Toggles ---
DEMO_MODE=true
MOCK_AUTH=true
MOCK_KYC=true
MOCK_GOVERNMENT_APIS=true
MOCK_NOTIFICATIONS=true
