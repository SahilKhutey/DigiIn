# ==============================================================================
# DigiIn (DigiLocker X) — Production & Sandbox Environment Configuration
# ==============================================================================
# NEVER commit production secrets or private keys to source control.

# --- Frontend Web Application (apps/web) ---
# Target: Vercel / Render Static Site
NODE_ENV=production
VITE_API_BASE_URL=https://digiin-api.onrender.com

# --- Backend API Service (services/api) ---
# Target: Render / Railway / Managed Host
ENVIRONMENT=production
PORT=8000
ALLOWED_ORIGINS=https://digiin.vercel.app,https://digiin-web.onrender.com

# --- Relational Database (SQLAlchemy) ---
# Supports PostgreSQL (Render/Supabase/Neon) or SQLite
# Example PostgreSQL: postgresql://user:password@hostname:5432/digilocker_x
DIGIIN_DATABASE_URL=sqlite:///./digiin_database.db

# --- Deterministic Sandbox & Safety Toggles ---
DEMO_MODE=true
MOCK_AUTH=true
MOCK_KYC=true
MOCK_GOVERNMENT_APIS=true
MOCK_NOTIFICATIONS=true
