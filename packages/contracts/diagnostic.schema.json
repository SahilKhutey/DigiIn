{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://digiin.example/contracts/diagnostic.v1.json",
  "title": "DigiIn Diagnostic v1",
  "type": "object",
  "required": ["transactionId", "documentLabel", "overallStatus", "steps", "issueCode", "supportReference"],
  "properties": {
    "transactionId": { "type": "string", "pattern": "^[a-z0-9-]{8,64}$" },
    "documentLabel": { "type": "string", "maxLength": 140 },
    "overallStatus": { "enum": ["resolved", "action_required", "unavailable"] },
    "issueCode": { "type": "string", "maxLength": 100 },
    "supportReference": { "type": "string", "maxLength": 100 },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "status", "message", "owner"],
        "properties": {
          "name": { "type": "string" },
          "status": { "enum": ["complete", "attention", "blocked", "not_started"] },
          "message": { "type": "string", "maxLength": 500 },
          "owner": { "type": "string", "maxLength": 140 },
          "nextAction": { "type": "string", "maxLength": 500 }
        }
      }
    }
  }
}
