{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://digilocker-x.gov.in/schemas/verification-request.schema.json",
  "title": "VerificationRequest",
  "type": "object",
  "required": [
    "request_id",
    "requester_id",
    "user_id",
    "purpose",
    "audience",
    "required_credential_type",
    "requested_attributes",
    "minimum_verification_level",
    "nonce",
    "expires_at"
  ],
  "properties": {
    "request_id": {
      "type": "string",
      "pattern": "^req_[a-zA-Z0-9_-]+$"
    },
    "requester_id": {
      "type": "string"
    },
    "user_id": {
      "type": "string"
    },
    "purpose": {
      "type": "string",
      "minLength": 3
    },
    "audience": {
      "type": "string"
    },
    "required_credential_type": {
      "type": "string"
    },
    "requested_attributes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "minimum_verification_level": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4
    },
    "nonce": {
      "type": "string",
      "minLength": 8
    },
    "status": {
      "type": "string",
      "enum": ["PENDING", "APPROVED", "REJECTED", "EXPIRED", "REVOKED"]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": false
}
