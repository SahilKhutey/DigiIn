DIGILOCKER_CLIENT_SECRET="digiin_mock_secret"
DIGILOCKER_REDIRECT_URI="http://localhost:8080/v1/digilocker/callback"

APP_BASE_URL="http://localhost:3000"
API_BASE_URL="http://localhost:8080"
